# Optional PostHog product analytics. Use a separate project token per environment.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Opt in to PostHog Logs billing after validating the project and retention.
POSTHOG_LOGS_ENABLED=false
TERMON_ENVIRONMENT=development
# Production only: use the digest emitted by the release workflow, never a tag.
TERMON_IMAGE=ghcr.io/OWNER/termon@sha256:DIGEST
