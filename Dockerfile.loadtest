FROM golang:1.27-trixie AS build

WORKDIR /src
COPY go.mod go.sum ./
COPY third_party/ultraviolet ./third_party/ultraviolet
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/termon-load ./cmd/termon-load

FROM scratch
WORKDIR /app
COPY --from=build /out/termon-load /app/termon-load
COPY content /app/content
ENTRYPOINT ["/app/termon-load"]
